#!/usr/bin/env python3
"""Launch the marathon planner from any working directory."""
import argparse
import sys
import webbrowser
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))


def port_number(value):
    try:
        port = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError('Port must be a whole number.')
    if not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError('Port must be between 1 and 65535.')
    return port


def main():
    parser = argparse.ArgumentParser(description='Your marathon planner: terminal or browser.')
    modes = parser.add_subparsers(dest='mode')
    modes.add_parser('terminal', help='Run the original interactive terminal planner')
    web = modes.add_parser('web', help='Start the web interface and open a browser')
    web.add_argument('--port', type=port_number, default=8000, help='Local port (default: 8000)')
    web.add_argument('--no-open', action='store_true', help='Start the server without opening a browser')
    args = parser.parse_args()
    if args.mode is None:
        if not sys.stdin.isatty():
            parser.print_help()
            return 0
        print('Marathon Planner\n1. Terminal planner\n2. Browser interface\n0. Exit')
        while True:
            choice = input('Choose a mode: ').strip()
            if choice == '0':
                return 0
            if choice in ('1', '2'):
                args.mode = 'terminal' if choice == '1' else 'web'
                args.port, args.no_open = 8000, False
                break
            print('Choose 1, 2, or 0.')
    if args.mode == 'terminal':
        import marathon_planner
        marathon_planner.main()
        return 0
    from web_app import Handler, ThreadingHTTPServer
    try:
        server = ThreadingHTTPServer(('127.0.0.1', args.port), Handler)
    except OSError as error:
        print(f'Could not start the web interface: {error}. Try a different --port.', file=sys.stderr)
        return 1
    url = f'http://127.0.0.1:{server.server_port}'
    print(f'Marathon Planner is running at {url}\nPress Ctrl+C to stop.', flush=True)
    print('The web journal is saved locally. Terminal check-ins remain session-only.', flush=True)
    try:
        if not args.no_open:
            try:
                opened = webbrowser.open(url)
            except webbrowser.Error:
                opened = False
            if not opened:
                print('No browser could be opened here. Use the address above on this machine.', flush=True)
        server.serve_forever()
    finally:
        server.server_close()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (KeyboardInterrupt, EOFError):
        print('\nPlanner closed.')
